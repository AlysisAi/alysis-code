{
  "// FE-9": "Type-checks the webview JS (media/*.js) that the main tsconfig (src/+test only) ignores.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "media/startView.js",
    "media/webview-globals.d.ts"
  ]
}
